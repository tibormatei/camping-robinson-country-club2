{
  "name": "camping-robinson-country-club-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.2.21",
  "engines": {
    "bun": ">=1.2.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "type-check": "bunx tsc -b --noEmit",
    "type-check:watch": "bunx tsc -b --noEmit --watch",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "typescript": "^5.9.3",
    "prettier": "^3.4.0",
    "vite": "^8.0.0",
    "@vitejs/plugin-react": "^6.0.2",
    "vite-tsconfig-paths": "^5.1.4"
  }
}
