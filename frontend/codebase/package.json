{
  "name": "camping-robinson-country-club-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.3",
  "engines": {
    "bun": ">=1.4.3"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "type-check": "bunx tsc -b --noEmit",
    "type-check:watch": "bunx tsc -b --noEmit --watch",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.3.0",
    "i18next": "^26.5.4",
    "i18next-browser-languagedetector": "^8.2.1",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-i18next": "^17.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/node": "^24.13.3",
    "typescript": "^5.9.3",
    "prettier": "^3.4.0",
    "vite": "^8.0.0",
    "@vitejs/plugin-react": "^6.0.2"
  }
}
